#!/usr/bin/env bash
# Runs the pest suites of the kit and of its libraries (opensim-engine,
# opensim-helpers, opensim-rest-php, siblings of this repository) with the PHP
# of a distribution and only the extensions the tools depend on, from copies of
# the working trees (nothing is written in them).
#
# The suites run in a container, on the podman of tests/.env (CONTAINER_CONNECTION: the machine that has the CPU, not the one
# you work on); the trees are sent to it as a tar stream, and the image with the PHP is made once.
#
# Usage, from the repository root:
#   tests/Packaging/distro-pest [base image]
#   tests/Packaging/distro-pest docker.io/library/ubuntu:24.04    # default: Debian 12
# PROJECTS="opensim-rest-php opensim-engine" RUN=opensim-engine tests/Packaging/distro-pest   # the trees sent, the suites run
# PEST_ARGS="--filter=EstateTest" RUN=opensim-engine tests/Packaging/distro-pest              # only some tests
#   PROJECTS  the trees sent to the container (the libraries a project needs by path included)
#   RUN       the projects whose suite is run (default: PROJECTS)
#   PEST_ARGS what is given to pest
# The PHP minimum of the projects is the one of Debian 12, so this is the test
# that the minimum and the dependencies of the packages are the real ones.

set -e

BASE=${1:-docker.io/library/debian:bookworm}
cd "$(git rev-parse --show-toplevel)"
source tests/bootstrap.sh
[[ -f vendor/bin/bash-helpers ]] || { echo "bash-tools is not installed: composer install" >&2; exit 1; }
source vendor/bin/bash-helpers

PROJECTS=${PROJECTS:-"opensim-rest-php opensim-engine opensim-helpers $(basename "$PWD")"}
RUN=${RUN:-$PROJECTS}
image=opensim-kit-pest-$(basename "$BASE" | tr ':.' '--')
# The mirror of the distribution does not always answer from the machine of the containers: the image is made again after a pause
for attempt in 1 2 3 4; do
    podman build -q -t "$image" -f tests/Packaging/pest-image.Containerfile --build-arg BASE="$BASE" tests/Packaging >/dev/null && break
    [[ $attempt -lt 4 ]] || die "the image of the tests cannot be made"
    warning "the image could not be made (attempt $attempt), again in 60 seconds"
    sleep 60
done

excludes=(--exclude=.git)
for p in $PROJECTS; do
    for dir in build upstream core dev tmp dist; do
        excludes+=(--exclude="$p/$dir")
    done
done

COPYFILE_DISABLE=1 tar -C "$(dirname "$PWD")" "${excludes[@]}" -cf - $PROJECTS | podman run --rm -i --memory=2g -e RUN="$RUN" -e PEST_ARGS="${PEST_ARGS:-}" "$image" bash -c '
set -e
mkdir /work
tar --warning=no-unknown-keyword -C /work -xf -
php -v | head -1
status=0
for p in $RUN; do
    echo "== $p"
    # One run: what it says, then its status
    (cd "/work/$p" && php vendor/bin/pest $PEST_ARGS >/tmp/pest.out 2>&1) || status=1
    grep -E "Tests:|Duration|⨯" /tmp/pest.out || true
    # No result at all: the suite did not even start
    grep -q "Tests:" /tmp/pest.out || tail -20 /tmp/pest.out
    # Why it failed: what the suite said from the first failure
    if grep -q "⨯" /tmp/pest.out; then sed -n "/FAILED/,\$p" /tmp/pest.out | head -"${FAILURES:-60}"; fi
done
exit $status
'

#!/usr/bin/perl
# A dotnet that says what OpenSimulator says when it starts and stops when it is told so (for lifecycle-scenario.sh): the
# connectors of a Robust loaded, the region of a simulator ready, a shutdown on its console (standard input) or a TERM.
use strict;
use warnings;
$| = 1;

if (grep { $_ eq '--list-runtimes' } @ARGV) {
    print "Microsoft.NETCore.App 8.0.4 [/usr/share/dotnet/shared/Microsoft.NETCore.App]\n";
    exit 0;
}
my @args = @ARGV;
my ($ini) = map { /^-inifile=(.*)/ ? $1 : () } @args;
my ($logfile) = map { /^-logfile=(.*)/ ? $1 : () } @args;
my ($logconfig) = map { /^-logconfig=(.*)/ ? $1 : () } @args;
my ($assembly) = grep { /\.dll$/ } @args;
$assembly //= '';
$0 = "dotnet @ARGV";

if ($logconfig && open(my $config, '<', $logconfig)) {
    local $/;
    my $text = <$config>;
    ($logfile) = $text =~ /<file\s+value="([^"]+)"/ unless $logfile;
}
sub say_log {
    my $message = shift;
    print "$message\n";
    if ($logfile && open(my $log, '>>', $logfile)) {
        print $log "$message\n";
        close $log;
    }
}
$SIG{TERM} = sub { say_log('[CONSOLE] Quitting'); exit 0 };

say_log('STARTING OPENSIM');
if ($assembly =~ /Robust\.dll$/) {
    my $in_list = 0;
    open(my $file, '<', $ini) or exit 2;
    while (my $line = <$file>) {
        $in_list = $1 eq 'ServiceList' if $line =~ /^\s*\[(\w+)\]/;
        say_log("[SERVER]: $1 loaded successfully") if $in_list && $line =~ /=\s*"[^"]*:(\w+)"/;
    }
} else {
    say_log('[REGION LOADER FILE SYSTEM]: Loaded config for region Plaza');
    say_log('[RegionReady]: Region "Plaza" is ready');
}
while (my $line = <STDIN>) {
    chomp $line;
    if ($line =~ /^shutdown/) {
        say_log('[CONSOLE] Quitting');
        exit 0;
    }
}
sleep 1 while 1;

#!/usr/bin/env php
<?php

/**
 * opensim: the command line of the kit. The commands the application knows (src/Console) are done here, the others by the
 * script they come from (libexec/opensim-legacy), until the last one is ported.
 */

declare(strict_types=1);

$root = dirname(realpath(__FILE__) ?: __FILE__, 2);

require $root . '/bootstrap.php';

exit((new OpenSimKit\Console\Application($root))->dispatch($_SERVER['argv']));

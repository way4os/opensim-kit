# What git tracks and the packages and the zip do not distribute (rsync style: /name at the root, name anywhere,
# a trailing / for a folder, globs are fine). What .gitignore ignores is not in the build at all.
/.distignore
/.editorconfig
/.gitignore
/.gitmodules
/.php-version
/.prettierignore
/.prettierrc.json
/DEVELOPERS.md
/ROADMAP.md
/dev
/packaging
/tools
/tests
/core
# Add-on binaries for OpenSim 0.9.1 and 0.9.2 (Mono), used by no script. The original MoneyServer.ini stays: the setup makes the
# one of a grid from it
/contrib/Gloebit
# What OSGrid publishes (contrib/osgrid, a closed module among it) is for reading here, not for distributing
/contrib/osgrid
/contrib/README.md
/contrib/MoneyServer/*/MoneyServer.exe
/contrib/MoneyServer/*/MoneyServer.exe.config
/contrib/MoneyServer/*/*.dll

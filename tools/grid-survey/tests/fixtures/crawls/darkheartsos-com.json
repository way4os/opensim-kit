   "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/application/files/presets/dhpg.css?ccm_nocache=f0efa146b11073ea56391d017b9905f28c22857a\" media=\"(prefers-color-scheme: light)\"><link rel=\"stylesheet\" type=\"text/css\" href=\"/concrete/themes/atomik/css/skins/midnight-velvet.css?ccm_nocache=f0efa146b11073ea56391d017b9905f28c22857a\" media=\"(prefers-color-scheme: dark)\">    \n\n\t<meta property=\"og:site_name\" content=\"Darkhearts Playground\">\n\t<meta property=\"og:locale\" content=\"en_GB\">\n\t<meta property=\"og:type\" content=\"website\">\n\t<meta property=\"og:title\" content=\"Register\">\n\t<meta property=\"og:url\" content=\"https://darkheartsos.net/signup\">\n\t\n<title>Register :: Darkhearts Playground</title>\n\n<meta http-equiv=\"content-type\" content=\"text/html; charset=UTF-8\">\n<meta name=\"description\" content=\"Create a Darkheart's Playground account: choose a username, set a password and join the community.\">\n<meta name=\"generator\" content=\"Concrete CMS\">\n<link rel=\"canonical\" href=\"https://darkheartsos.net/signup\">\n<script type=\"text/javascript\">\n    var CCM_DISPATCHER_FILENAME = \"/index.php\";\n    var CCM_CID = 284;\n    var CCM_EDIT_MODE = false;\n    var CCM_ARRANGE_MODE = false;\n    var CCM_IMAGE_PATH = \"/concrete/images\";\n    var CCM_APPLICATION_URL = \"https://darkheartsos.net\";\n    var CCM_REL = \"\";\n    var CCM_ACTIVE_LOCALE = \"en_GB\";\n    var CCM_USER_REGISTERED = false;\n</script>\n\n<link href=\"/concrete/css/fontawesome/all.css?ccm_nocache=f0efa146b11073ea56391d017b9905f28c22857a\" rel=\"stylesheet\" type=\"text/css\" media=\"all\">\n<script type=\"text/javascript\" src=\"/concrete/js/jquery.js?ccm_nocache=f0efa146b11073ea56391d017b9905f28c22857a\"></script>\n        <meta property=\"og:description\" content=\"Create a Darkheart&#039;s Playground account: choose a username, set a password and join the community.\">\n    <meta property=\"og:image\" content=\"https://darkheartsos.net/application/files/7817/7477/8352/DHHeartLogo.png\">\n    <meta name=\"twitter:card\" content=\"summary\">\n    <meta name=\"twitter:title\" content=\"Register\">\n    <meta name=\"twitter:description\" content=\"Create a Darkheart&#039;s Playground account: choose a username, set a password and join the community.\">\n    <meta name=\"twitter:image\" content=\"https://darkheartsos.net/application/files/7817/7477/8352/DHHeartLogo.png\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <script src=\"/legacy-links.js\" defer></script>\n    <style>\n        /*\n         * Match the CMS navigation bar to the portal app's navigation bar.\n         *\n         * The portal header is rgba(18, 16, 26, 0.82) over #212529, which\n         * renders as #15141D. A solid colour is used here because the CMS\n         * navbar is fixed and page content scrolls beneath it.\n         */\n        div.ccm-page div.ccm-block-top-navigation-bar .navbar {\n            background-color: #15141D;\n        }\n\n        /*\n         * Match the CMS navigation search field to the portal login fields:\n         * #14111C background, purple 28% border, 8px radius, 44px tall.\n         */\n        div.ccm-page div.ccm-block-top-navigation-bar input[type=\"search\"] {\n            background-color: #14111C;\n            border: 1px solid rgba(167, 139, 250, 0.28);\n            border-radius: 8px;\n            color: #F5F2FA;\n            height: 44px;\n            padding: 0 12px;\n            box-shadow: none;\n        }\n\n        div.ccm-page div.ccm-block-top-navigation-bar input[type=\"search\"]::placeholder {\n            color: #F5F2FA;\n            opacity: 1;\n        }\n\n        div.ccm-page div.ccm-block-top-navigation-bar input[type=\"search\"]:focus {\n            background-color: #14111C;\n            border-color: rgba(167, 139, 250, 0.28);\n            color: #F5F2FA;\n            box-shadow: none;\n            outline: none;\n        }\n\n        /*\n         * Tighten the navigation spacing so every menu option stays on one\n         * line: 20px per link side (40px between items) is too wide.\n         */\n        div.ccm-page div.ccm-block-top-navigation-bar .navbar-nav .nav-link {\n            padding-left: 10px;\n            padding-right: 10px;\n        }\n\n        div.ccm-page div.ccm-block-top-navigation-bar .navbar-brand {\n            margin-right: 8px;\n        }\n\n        /*\n         * Mobile hamburger: the three icon bars were black and hard to see on\n         * the dark navbar. Use the same pink as hyperlinks (e.g. the footer\n         * Privacy Policy link).\n         */\n        div.ccm-page div.ccm-block-top-navigation-bar .navbar-toggler .icon-bar {\n            background-color: #C04BD4;\n        }\n\n        /*\n         * Hero offset-title: the theme painted a solid $body-bg (#212529)\n         * panel behind the title and text, which covered the bottom of the\n         * image. The panel is now fully transparent, so the image shows\n         * through behind the text.\n         *\n         * Review M04: the paragraph was #7c8088 on #2c2c3a (3.47:1). It is\n         * now #e9ecef with a text shadow, because there is no panel to\n         * provide the contrast.\n         */\n        @media (min-width: 1200px) {\n            div.theme-atomik div.ccm-block-hero-image-offset-title div.ccm-block-hero-image-text {\n                background-color: transparent;\n                background-image: none;\n            }\n        }\n\n        div.theme-atomik div.ccm-block-hero-image-offset-title div.ccm-block-hero-image-text h2 {\n            color: #ffffff;\n            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.75);\n        }\n\n        div.theme-atomik div.ccm-block-hero-image-offset-title div.ccm-block-hero-image-text p {\n            color: #e9ecef;\n            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.75);\n        }\n\n        /*\n         * Review M04 (follow-up): the two originally failing paragraphs are\n         * feature-link text, not hero offset-title text, and stayed at the\n         * theme's #7c8088. The same #9aa0b0 gives about 5.25:1 on the\n         * #2c2c3a stripe without changing size or weight.\n         */\n        div.theme-atomik div.ccm-block-feature-link div.ccm-block-feature-link-text p {\n            color: #9aa0b0;\n        }\n\n        /*\n         * Review M07: at 390px the brand (86px mark plus a 32px uppercase\n         * name) ran past the viewport and pushed the menu button onto a\n         * second row. Shrink both, keep the bar on one line, and ellipsise\n         * rather than overflow if the name still does not fit.\n         */\n        @media (max-width: 575.98px) {\n            /*\n             * Review M07 (follow-up): nowrap kept the brand and toggle on one\n             * row, but it also forced the expanded menu to share that row,\n             * which squeezed the search field to about 34px at 320px. Let the\n             * navbar wrap and give the collapsed menu its own full-width row.\n             */\n            div.ccm-page div.ccm-block-top-navigation-bar .navbar-collapse {\n                flex-basis: 100%;\n            }\n\n            div.ccm-page div.ccm-block-top-navigation-bar .navbar-nav {\n                width: 100%;\n            }\n\n            div.ccm-page div.ccm-block-top-navigation-bar .navbar form {\n                width: 100%;\n            }\n\n            div.ccm-page div.ccm-block-top-navigation-bar .navbar-brand {\n                font-size: 18px;\n                margin-right: 4px;\n                max-width: calc(100% - 56px);\n                overflow: hidden;\n                text-overflow: ellipsis;\n                white-space: nowrap;\n            }\n\n            div.ccm-page div.ccm-block-top-navigation-bar .navbar-brand img {\n                max-height: 30px;\n                width: auto;\n                margin-right: 6px;\n            }\n\n            div.ccm-page div.ccm-block-top-navigation-bar .navbar-toggler {\n                margin-left: auto;\n                flex-shrink: 0;\n            }\n\n            /*\n             * Bootstrap rows carry negative side margins, which on a 390px\n             * screen still produce a few pixels of horizontal scroll. Clip\n             * them so the page never scrolls sideways on a phone.\n             *\n             * \"clip\" rather than \"hidden\": hidden would turn .ccm-page into a\n             * scroll container and break the theme's 12 position:sticky rules.\n             */\n            div.ccm-page {\n                overflow-x: clip;\n            }\n        }\n\n        /*\n         * Review P03: heading levels were raised to remove the outline jumps\n         * (h2 to h4 on the home page, h6/h5 on Services, and a mid-page h1).\n         * These rules keep the original visual scale, so the change is\n         * structural only. Page IDs scope the two different card sizes.\n         */\n        div.ccm-page div.ccm-block-feature-link h1 {\n            font-size: 56px;\n            line-height: 1.2;\n            margin: 0 0 8px;\n            text-transform: uppercase;\n        }\n\n        div.ccm-page-id-1 div.ccm-block-feature-stacked h3 {\n            font-size: 23.4px;\n            line-height: 1.2;\n            margin: 0 0 24px;\n        }\n\n        div.ccm-page-id-247 div.ccm-block-feature-stacked h3 {\n            font-size: 16px;\n            line-height: 1.2;\n            margin: 0 0 24px;\n        }\n\n        div.ccm-page-id-247 div.ccm-block-content h2.h5 {\n            font-family: Inter, sans-serif;\n            font-size: 20px;\n            font-weight: 800;\n            line-height: 1.2;\n            margin: 0 0 8px;\n            text-transform: none;\n        }\n\n        div.ccm-block-hero-image-text h2.hero-subtitle {\n            font-family: Inter, sans-serif;\n            font-size: 26.8px;\n            font-weight: 800;\n            line-height: 1.2;\n            margin: 0 0 8px;\n            text-transform: none;\n        }\n\n        div.ccm-block-hero-image-offset-title h2.offset-title-heading {\n            font-size: 50.6px;\n            font-weight: 500;\n            line-height: 1.1;\n            margin: 0;\n            text-transform: none;\n        }\n\n        div.ccm-block-testimonial-hero-quote blockquote {\n            font-size: 23.4px;\n            font-weight: 800;\n            line-height: 1.2;\n            margin: 0;\n            padding: 0;\n            border: 0;\n        }\n\n        /*\n         * Review M08: hero images are now real <picture> elements instead of\n         * CSS background images, so they can carry srcset and loading hints.\n         * These rules keep the previous layout: the image fills the same box,\n         * and the offset-title image keeps its natural width.\n         */\n        div.ccm-block-hero-image div.ccm-block-hero-image-image {\n            position: relative;\n            overflow: hidden;\n        }\n\n        div.ccm-block-hero-image div.ccm-block-hero-image-image picture,\n        div.ccm-block-hero-image-offset-title .ccm-block-hero-image-offset-image-container picture {\n            display: contents;\n        }\n\n        div.ccm-block-hero-image div.ccm-block-hero-image-image img {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            object-position: 50% 50%;\n        }\n\n        /*\n         * Review M08 (distortion): the offset-title image used to keep its\n         * natural height at every width, which squeezed it on phones. Fill the\n         * reserved band and crop instead of stretching.\n         */\n        div.ccm-block-hero-image-offset-title .ccm-block-hero-image-offset-image-container img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            object-position: 50% 50%;\n        }\n\n        /*\n         * Review M08 (CLS): the offset-title block is height: 0 until its JS\n         * runs. The template now reserves the cropped height, which only works\n         * if the block itself is allowed to grow.\n         */\n        div.theme-atomik div.ccm-block-hero-image-offset-title {\n            height: auto;\n        }\n        /*\n         * Review M06: pause control for the rotating slider (WCAG 2.2.2).\n         */\n        div.ccm-image-slider-container {\n            position: relative;\n        }\n\n        .dhpg-slider-toggle {\n            position: absolute;\n            top: .75rem;\n            right: .75rem;\n            z-index: 5;\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            border: 1px solid rgba(255, 255, 255, 0.35);\n            background: rgba(21, 20, 29, 0.75);\n            color: #fff;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n        }\n\n        .dhpg-slider-toggle:hover,\n        .dhpg-slider-toggle:focus-visible {\n            background: #C04BD4;\n            border-color: #C04BD4;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"theme-atomik ccm-page ccm-page-id-284 page-type-page page-template-full\">\n\n\n\n\n    \n<div class=\"ccm-block-top-navigation-bar\" style=\"display: none\" data-transparency=\"navbar\">\n    <nav class=\"navbar navbar-expand-lg navbar-light fixed-top\">\n        <div class=\"container-fluid\">\n            <a class=\"navbar-brand\" href=\"https://darkheartsos.net/\">\n                                    <img src=\"https://darkheartsos.net/application/files/7817/7477/8352/DHHeartLogo.png\" class=\"logo align-text-center\" alt=\"\">\n                                            <img src=\"https://darkheartsos.net/application/files/7817/7477/8352/DHHeartLogo.png\" class=\"logo-transparent align-text-center\" alt=\"\">\n                                        DARKHEART&#039;S PLAYGROUND                                \n                            </a>\n\n                            <button class=\"navbar-toggler collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#top-navigation-bar-184\" aria-controls=\"#top-navigation-bar-184\" aria-expanded=\"false\" aria-label=\"Toggle Navigation\">\n                                        <span class=\"icon-bar\"></span>\n                    <span class=\"icon-bar\"></span>\n                    <span class=\"icon-bar\"></span>\n                    \n                                    </button>\n                <div class=\"collapse navbar-collapse\" id=\"top-navigation-bar-184\">\n                                            <form method=\"get\" action=\"https://darkheartsos.net/search\">\n                            <input class=\"form-control\" type=\"search\" name=\"query\" placeholder=\"Search\" aria-label=\"Search\">\n                            <button class=\"btn btn-light bg-white ms-2\" type=\"submit\" aria-label=\"Search\">\n                                <i class=\"fas fa-search text-secondary\" aria-hidden=\"true\"></i>\n                            </button>\n                        </form>\n                                                                                <ul class=\"navbar-nav\">\n                                                        <li class=\"nav-item dropdown\">\n                                                                        <a class=\"nav-link dropdown-toggle\" data-concrete-toggle=\"dropdown\" target=\"_self\" href=\"https://darkheartsos.net/about\">\n                                        About                                    </a>\n                                    <ul class=\"dropdown-menu\">\n                                                                                    <li><a class=\"dropdown-item\" target=\"_self\" href=\"https://darkheartsos.net/about/services\">Services</a></li>\n                                                                            </ul>\n                                </li>\n                                                                                    <li class=\"nav-item\"><a class=\"nav-link\" target=\"_self\" href=\"https://darkheartsos.net/user-access\">My Account</a></li>\n                                                                                    <li class=\"nav-item\"><a class=\"nav-link active\" target=\"_self\" href=\"https://darkheartsos.net/signup\">Register</a></li>\n                                                                        </ul>\n                                    </div>\n                    </div>\n    </nav>\n</div>\n\n\n\n    <iframe src=\"/user-portal/register\" data-portal-sync=\"1\" style=\"width:100%;height:100vh;border:0;\" title=\"Register\"></iframe>\n\n<footer>\n    <section class=\"mb-4\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col-md-3\">\n                    \n\n    <div class=\"atomik-logo\"><img src=\"/application/files/7817/7477/8352/DHHeartLogo.png\" alt=\"Darkheart's Playground\" width=\"80\" height=\"80\" loading=\"lazy\" decoding=\"async\"><span>DARKHEART&#39;S PLAYGROUND</span></div>\r\n\n                </div>\n                <div class=\"col-md-2 col-6\">\n                                    </div>\n                <div class=\"col-md-2 col-6\">\n                    \n\n    <p><a href=\"https://darkheartsos.net/policies/privacy-policy\">Privacy Policy</a></p>\r\n\n                </div>\n                <div class=\"col-md-5 col-12\">\n                    <hr class=\"d-md-none\">\n                    \n\n    <p><a href=\"/terms-service\">Terms of Service</a></p>\r\n\n\n\n    \n\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"concrete-branding\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col-md-6\">\n                    Copyright 2026.                 </div>\n            </div>\n        </div>\n    </section>\n</footer>\n\n\n</div>\n\n<script type=\"text/javascript\" src=\"/concrete/js/vue.js?ccm_nocache=f0efa146b11073ea56391d017b9905f28c22857a\"></script>\n<script type=\"text/javascript\" src=\"/concrete/js/bootstrap.js?ccm_nocache=138b43580616b0b6fec0ada34ab175a1b08a5d46\"></script>\n<script type=\"text/javascript\" src=\"/concrete/js/moment.js?ccm_nocache=f0efa146b11073ea56391d017b9905f28c22857a\"></script>\n<script type=\"text/javascript\" src=\"/ccm/assets/localization/moment/js\"></script>\n<script type=\"text/javascript\" src=\"/application/themes/atomik/main.js\"></script>\n<script type=\"text/javascript\">\n// Refresh once after the user logs in to the embedded portal, so the member\n// navigation and the admin toolbar appear immediately instead of on the next\n// click.\n//\n// This poller only READS status (GET /portal-auth/portal). It never creates a\n// session and never clears the sign-out marker.\n//\n// On a portal login it either swaps just the navigation (regular members) or\n// reloads once for administrators/editors, who need the admin toolbar.\n(function () {\n    var iframe = document.querySelector(\"iframe[data-portal-sync]\");\n    if (!iframe) {\n        return;\n    }\n\n    var busy = false;\n    var done = false;\n    var portalMisses = 0;\n    var PORTAL_MISSES_BEFORE_LOGOUT = 3;\n\n    // Nothing to sync (page rendered anonymously and the portal session has\n    // ended): slow the poller from 3s to 15s so an idle tab stops asking the\n    // bridge - and the relay behind it - about a session that cannot exist.\n    // Any real change is still picked up within one slow tick, and returning\n    // to the tab polls immediately.\n    var idle = false;\n    var idleTick = 0;\n    var IDLE_EVERY = 5;\n\n    // Whether THIS page was rendered with a CMS session. A portal logout has\n    // to reload the page even when the CMS session has already ended by the\n    // time the poller notices - in that case cmsUser is null, but the\n    // navigation on screen is still the member one.\n    var wasLoggedIn = false;\n\n    function refreshNav() {\n        // Fetch the same page (this also lets the server create the CMS\n        // session) and swap only the navigation, leaving the portal iframe\n        // and the rest of the page untouched.\n        fetch(window.location.href, {\n            credentials: \"same-origin\",\n            cache: \"no-store\"\n        }).then(function (r) {\n            return r.text();\n        }).then(function (html) {\n            var doc = new DOMParser().parseFromString(html, \"text/html\");\n            var fresh = doc.querySelector(\".ccm-block-top-navigation-bar nav\");\n            var current = document.querySelector(\".ccm-block-top-navigation-bar nav\");\n            if (fresh && current) {\n                current.replaceWith(fresh);\n            }\n        }).catch(function () {});\n    }\n\n    function logoutAndReload() {\n        fetch(\"/portal-auth/logout\", {\n            method: \"POST\",\n            credentials: \"same-origin\",\n            cache: \"no-store\",\n            headers: { \"Accept\": \"application/json\" }\n        }).then(function () {\n            window.location.reload();\n        }).catch(function () {\n            window.location.reload();\n        });\n    }\n\n    function check() {\n        if (busy || done || document.visibilityState === \"hidden\") {\n            return;\n        }\n        if (idle && (++idleTick % IDLE_EVERY) !== 0) {\n            return;\n        }\n        busy = true;\n        fetch(\"/portal-auth/portal\", {\n            credentials: \"same-origin\",\n            cache: \"no-store\",\n            headers: { \"Accept\": \"application/json\" }\n        }).then(function (r) {\n            return r.json().catch(function () { return null; });\n        }).then(function (d) {\n            busy = false;\n            if (!d || !d.ok) {\n                return;                 // transient - keep checking\n            }\n            if (d.signedOut) {\n                return;                 // signed out of the CMS: keep watching\n            }\n\n            if (!d.portalLoggedIn) {\n                // Portal session ended. Nothing to undo on a page that was\n                // rendered anonymously.\n                if (!wasLoggedIn) {\n                    idle = true;            // slow poll until something changes\n                    return;\n                }\n\n                // The portal rotates SESSIONID on every token refresh, and the\n                // relay can briefly 404 a session ID issued a moment ago, so a\n                // single miss is not proof of a logout. Require a few in a row\n                // (about 9s) before reloading, otherwise the page reloads in\n                // the middle of a refresh and can leave the portal stuck.\n                portalMisses++;\n                if (portalMisses >= PORTAL_MISSES_BEFORE_LOGOUT) {\n                    done = true;\n                    if (d.cmsUser) {\n                        // CMS session still alive: end it, then re-render.\n                        logoutAndReload();\n                    } else {\n                        // CMS session already gone: the page is simply stale.\n                        window.location.reload();\n                    }\n                }\n                return;\n            }\n            portalMisses = 0;\n            wasLoggedIn = true;\n            idle = false;               // back to the fast poll\n\n            if (d.cmsUser) {\n                if (!d.portalSynced) {\n                    done = true;        // CMS session did not come from the portal\n                }\n                return;                 // keep watching for a portal logout\n            }\n\n            done = true;\n            if (d.privileged) {\n                // Admins / editors need the admin toolbar, which only\n                // initialises on a full load.\n                window.location.reload();\n            } else {\n                // Everyone else: just refresh the navigation.\n                refreshNav();\n            }\n        }).catch(function () {\n            busy = false;               // transient - keep checking\n        });\n    }\n\n    // Coming back to an idle tab should not wait for the slow tick.\n    document.addEventListener(\"visibilitychange\", function () {\n        if (document.visibilityState === \"visible\") {\n            idleTick = IDLE_EVERY - 1;  // next check() runs immediately\n            check();\n        }\n    });\n\n    window.setInterval(check, 3000);\n    window.setTimeout(check, 1500);\n})();\n</script>\n\n</body>\n</html>\n",
   "error": null,

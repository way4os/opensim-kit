    <!-- Bootstrap Core JavaScript -->\n    <script src=\"https://zetaworlds.com/theme/js/bootstrap.js\"></script>\n\t\n    <!-- Script to Activate the Carousel -->\n    <script>\n    $('.carousel').carousel({\n        interval: 5000 //changes the speed\n    })\n    </script>\n\t\n\t<script>\n\t\t\n\t\tif (document.getElementsByClassName(\"time\"))\n\t\t\n\t\tfunction psdtclock() {\n\t\t\tif (document.getElementsByClassName(\"time\") != null)\n\t\t\t{\n\t\t\t\tdocument.getElementById('psdt1').innerHTML = moment().tz(\"America/Los_Angeles\").format('ddd Do MMM YYYY');\n\t\t\t\tdocument.getElementById('psdt2').innerHTML = moment().tz(\"America/Los_Angeles\").format('HH');\n\t\t\t\tdocument.getElementById('psdt3').innerHTML = moment().tz(\"America/Los_Angeles\").format('mm');\n\t\t\t\tdocument.getElementById('psdt4').innerHTML = moment().tz(\"America/Los_Angeles\").format('ss');\n\t\t\t\tdocument.getElementById('psdt5').innerHTML = moment().tz(\"America/Los_Angeles\").format('z');\n\t\t\t}\n\t\t};\n\t\t\n\t\tfunction utcclock() {\n\t\t\tif (document.getElementsByClassName(\"time\") != null)\n\t\t\t{\n\t\t\t\tdocument.getElementById('utc1').innerHTML = moment().utc().format('ddd Do MMM YYYY');\n\t\t\t\tdocument.getElementById('utc2').innerHTML = moment().utc().format('HH');\n\t\t\t\tdocument.getElementById('utc3').innerHTML = moment().utc().format('mm');\n\t\t\t\tdocument.getElementById('utc4').innerHTML = moment().utc().format('ss');\n\t\t\t\tdocument.getElementById('utc5').innerHTML = moment().utc().format('z');\n\t\t\t}\n\t\t};\n\t\t\n\t\tfunction StartClocks() {\n\t\t\tif (document.getElementsByClassName(\"time\") != null)\n\t\t\t{\n\t\t\t\tsetInterval(utcclock, 500);\n\t\t\t\tsetInterval(psdtclock, 500);\n\t\t\t}\n\t\t}\n\t\t\n\t\twindow.onload=function() {\n\t\t\tif (document.getElementsByClassName(\"time\") != null)\n\t\t\t{\n\t\t\t\tStartClocks();\n\t\t\t}\n\t\t}\t\t\t\n\t\t\n\t</script>\n\n\n</body>\n</html>\n",
